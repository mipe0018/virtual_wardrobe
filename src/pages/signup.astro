---
import Layout from "../layouts/Layout.astro";
import "../styles/signup.css";
---

<Layout title="Closet — Create Your Closet">

  <div class="auth-page">

    <div class="auth-window">

      <div class="auth-window-bar">
        <span>CREATE_CLOSET.EXE</span>

        <div>
          <span>−</span>
          <span>□</span>
          <span>×</span>
        </div>
      </div>

      <div class="auth-content">

        <p class="auth-eyebrow">
          WELCOME TO CLOSET
        </p>

        <h1>Create your closet.</h1>

        <p class="auth-intro">
          Build your personal digital wardrobe and start styling.
        </p>

        <form class="signup-form">

          <label>
            NAME

            <input
              type="text"
              id="signup-name"
              placeholder="Your name"
              required
            />
          </label>

          <label>
            MODEL TYPE
            <select id="signup-gender" required>
              <option value="">Choose Woman or Man</option>
              <option value="woman">Woman</option>
              <option value="man">Man</option>
            </select>
          </label>

          <label>
            EMAIL

            <input
              type="email"
              id="signup-email"
              placeholder="your@email.com"
              required
            />
          </label>

          <label>
            PASSWORD

            <span class="password-field">
              <input
                type="password"
                id="signup-password"
                placeholder="••••••••"
                autocomplete="new-password"
                required
              />

              <button
                type="button"
                class="password-toggle"
                id="signup-password-toggle"
                aria-label="Show password"
                aria-pressed="false"
              >
                <svg
                  viewBox="0 0 24 24"
                  width="16"
                  height="16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z" />
                  <circle cx="12" cy="12" r="3" />
                </svg>
              </button>
            </span>
          </label>

          <label>
            CONFIRM PASSWORD

            <span class="password-field">
              <input
                type="password"
                id="signup-password-confirm"
                placeholder="••••••••"
                autocomplete="new-password"
                required
              />

              <button
                type="button"
                class="password-toggle"
                id="signup-password-confirm-toggle"
                aria-label="Show password"
                aria-pressed="false"
              >
                <svg
                  viewBox="0 0 24 24"
                  width="16"
                  height="16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z" />
                  <circle cx="12" cy="12" r="3" />
                </svg>
              </button>
            </span>
          </label>

          <button type="submit" id="signup-submit">
            CREATE CLOSET ↗
          </button>

        </form>

        <p class="auth-message" id="signup-message" role="alert" aria-live="polite"></p>

        <p class="auth-switch">
          Already have a closet?

          <a href="/login">
            LOG IN
          </a>
        </p>

      </div>

    </div>

  </div>

</Layout>

<script>
  import { supabase } from "../lib/supabase";

  const signupForm =
    document.querySelector(".signup-form") as HTMLFormElement;

  const signupName =
    document.querySelector("#signup-name") as HTMLInputElement;

  const signupEmail =
    document.querySelector("#signup-email") as HTMLInputElement;

  const signupPassword =
    document.querySelector("#signup-password") as HTMLInputElement;

  const signupPasswordConfirm =
    document.querySelector("#signup-password-confirm") as HTMLInputElement;

  const signupGender =
    document.querySelector("#signup-gender") as HTMLSelectElement;

  const signupButton =
    document.querySelector("#signup-submit") as HTMLButtonElement;

  const signupMessage =
    document.querySelector("#signup-message") as HTMLElement;

  /* Password visibility toggles: one independent control per field. Real
     <button type="button"> elements (never submit the form), the password
     VALUE is never touched — only the input's `type` and the accessible
     name/state change. Nothing is stored or logged. */
  function wirePasswordToggle(
    input: HTMLInputElement,
    toggle: HTMLButtonElement
  ) {
    if (!input || !toggle) return;
    toggle.addEventListener("click", () => {
      const revealing = input.type === "password";
      input.type = revealing ? "text" : "password";
      const label = revealing ? "Hide password" : "Show password";
      toggle.setAttribute("aria-label", label);
      toggle.setAttribute("aria-pressed", String(revealing));
      toggle.classList.toggle("is-revealed", revealing);
      input.focus();
    });
  }

  wirePasswordToggle(
    signupPassword,
    document.querySelector("#signup-password-toggle") as HTMLButtonElement
  );
  wirePasswordToggle(
    signupPasswordConfirm,
    document.querySelector(
      "#signup-password-confirm-toggle"
    ) as HTMLButtonElement
  );

  signupForm?.addEventListener("submit", async (event) => {
    event.preventDefault();

    signupMessage.textContent = "";

    const email = signupEmail.value.trim();
    const password = signupPassword.value;
    const passwordConfirm = signupPasswordConfirm.value;

    if (
      !signupName.value.trim() ||
      !email ||
      !password ||
      !passwordConfirm ||
      (signupGender.value !== "woman" && signupGender.value !== "man")
    ) {
      signupMessage.textContent =
        "Enter your name, email, and password to create your closet.";
      return;
    }

    // Block the request entirely when the two passwords differ.
    if (password !== passwordConfirm) {
      signupMessage.textContent =
        "Passwords do not match. Enter the same password in both fields.";
      signupPasswordConfirm.focus();
      return;
    }

    if (!supabase) {
      signupMessage.textContent = "Authentication is not configured. Add the Supabase URL and public anon key to your local .env file.";
      return;
    }

    signupButton.disabled = true;
    signupButton.textContent = "CREATING CLOSET...";

    try {
      const { data, error } = await supabase.auth.signUp({
        email,
        password,
        options: {
          data: {
            name: signupName.value.trim(),
            gender: signupGender.value,
          },
        },
      });

      if (error) {
        console.warn("Supabase signup failed.", error);
        const errorMessage = error.message.toLowerCase();

        if (
          error.code === "user_already_exists" ||
          errorMessage.includes("already registered") ||
          errorMessage.includes("already been registered")
        ) {
          signupMessage.textContent = "An account with this email already exists. Try logging in instead.";
        } else if (
          error.code === "weak_password" ||
          errorMessage.includes("password should be")
        ) {
          signupMessage.textContent = "Choose a stronger password and try again.";
        } else if (
          error.code === "email_address_invalid" ||
          errorMessage.includes("invalid email")
        ) {
          signupMessage.textContent = "Enter a valid email address.";
        } else {
          signupMessage.textContent = "We couldn't create your closet. Please check your details and try again.";
        }
        return;
      }

      if (data.session) {
        window.location.href = "/profile";
        return;
      }

      signupMessage.textContent =
        "Your account was created. Check your email to confirm it, then log in.";
    } catch (error) {
      console.error("Unexpected error while creating an account.", error);
      signupMessage.textContent = "We couldn't connect to authentication. Please try again.";
    } finally {
      signupButton.disabled = false;
      signupButton.textContent = "CREATE CLOSET ↗";
    }
  });
</script>