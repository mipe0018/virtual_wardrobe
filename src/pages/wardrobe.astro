---
import Layout from "../layouts/Layout.astro";
import "../styles/wardrobe.css";
import ProfileTheme from "../components/ProfileTheme.astro";
---

<Layout title="DRESSED — Style Your Character" header="app">
  <ProfileTheme />

  <div class="wardrobe">

    <section class="wardrobe-screen">

      <div class="wardrobe-toolbar">
        <span>DRESSED STYLE STUDIO</span>
        <a href="/closet">OPEN CLOSET LIBRARY →</a>
      </div>

      <div class="wardrobe-main">

        <div class="model-area">
          <div class="model-window">
            <div class="model-window-header">
              <span>MY DRESSED CHARACTER</span>
              <span>♡</span>
            </div>
            <div class="wardrobe-model" id="wardrobe-model">
              <div class="wardrobe-model-empty">
                <span>♙</span>
                <p>NO PERSONAL PHOTO YET</p>
                <a href="/profile">UPLOAD PHOTO</a>
              </div>
            </div>
            <div class="model-status" id="model-status">
              NO DRESSED CHARACTER YET
            </div>
          </div>
          <section class="saved-outfits" aria-labelledby="saved-outfits-heading">
            <h2 id="saved-outfits-heading">SAVED OUTFITS</h2>
            <div class="saved-outfit-picker" id="saved-outfits-grid" aria-live="polite"></div>
          </section>
        </div>

        <aside class="clothing-panel" aria-label="Clothing and accessories">
          <section class="style-panel">
            <div class="style-panel-title">
              <span>CLOTHING</span>
              <span>♡</span>
            </div>
            <div class="category-list" aria-label="Filter clothing by category">
              <button class="category-button category-button--active" type="button" data-category="ALL" aria-pressed="true">
                ALL
              </button>
            </div>
            <a href="/profile" class="upload-link">MANAGE CLOTHING IN PROFILE</a>
          </section>

          <section class="clothing-area" aria-label="Clothing items">
            <div class="clothing-heading">
              <span id="clothing-heading">ALL ITEMS</span>
            </div>
            <div class="clothing-grid" id="clothing-grid" aria-live="polite"></div>
          </section>
        </aside>

        <aside class="outfit-panel" aria-label="Outfit tools">
          <section class="outfit-bar">
            <div class="outfit-summary">
              <label class="outfit-label" for="outfit-name">SELECTED ITEMS</label>
              <input id="outfit-name" type="text" value="UNTITLED OUTFIT" maxlength="60" />
              <div class="current-outfit-items" id="current-outfit-items">
                <p class="outfit-empty">Select clothes to start your outfit.</p>
              </div>
            </div>

            <div class="outfit-actions">
              <button type="button" id="save-outfit">SAVE OUTFIT</button>
              <button type="button" id="apply-outfit">APPLY OUTFIT</button>
              <button type="button" id="clear-outfit">CLEAR OUTFIT</button>
              <p class="outfit-message" id="outfit-message" role="status" aria-live="polite"></p>
            </div>

            <section class="placement-panel" id="placement-panel" aria-label="Placement editor" hidden>
            <div class="placement-panel-title">
              <span>ADJUST PLACEMENT</span>
              <span id="placement-item-name"></span>
            </div>
            <label class="placement-field" for="placement-anchor">
              <span>ATTACH ANCHOR</span>
              <select id="placement-anchor"></select>
            </label>
            <label class="placement-field" for="placement-scale">
              <span>SIZE <small id="placement-scale-value">1.00x</small></span>
              <input id="placement-scale" type="range" min="0.4" max="2" step="0.01" value="1" />
            </label>
            <label class="placement-field placement-free-toggle" for="placement-free">
              <span>FREE SCALING</span>
              <input id="placement-free" type="checkbox" />
            </label>
            <div class="placement-free-fields" id="placement-free-fields" hidden>
              <label class="placement-field" for="placement-scale-x">
                <span>WIDTH <small id="placement-scale-x-value">100%</small></span>
                <input id="placement-scale-x" type="range" min="0.4" max="2" step="0.01" value="1" />
              </label>
              <label class="placement-field" for="placement-scale-y">
                <span>HEIGHT <small id="placement-scale-y-value">100%</small></span>
                <input id="placement-scale-y" type="range" min="0.4" max="2" step="0.01" value="1" />
              </label>
            </div>
            <small class="placement-readout" id="placement-readout"></small>
            <p class="placement-hint">TAP TO SELECT · DRAG TO MOVE · PINCH TO RESIZE</p>
            <div class="placement-actions">
              <button type="button" id="placement-reset">RESET</button>
              <button type="button" id="placement-done">DONE</button>
            </div>
            </section>
          </section>
        </aside>

      </div>

    </section>

  </div>

</Layout>

<script>
  import { supabase } from "../lib/supabase";
  import {
    CLOTHING_CATEGORIES,
    normalizeClothingCategory,
    categoryLabel,
    clothingLayerOrder,
    dressedAnchor,
    DRESSED_ANCHORS,
    type DressedAnchor,
  } from "../lib/shared/clothing-categories";
  import {
    effectiveScaleX,
    effectiveScaleY,
    isSamePlacement,
    parsePlacement,
    resolveItemPlacement,
    type Placement,
  } from "../lib/shared/clothing-placement";
  import {
    CURRENT_CLOTHING_ASSET_VERSION,
    type ClothingBaseAsset,
    type ClothingBaseType,
  } from "../lib/shared/clothing-assets";
  import { DRESSED_GEOMETRY_CONTRACT_VERSION } from "../lib/shared/clothing-geometry";
  import {
    readDressedCharacterCache,
    cacheDressedCharacter,
  } from "../lib/client/dressed-character";
  import {
    deleteSavedDressedOutfit,
    loadSavedDressedOutfits,
    loadPersistentWardrobe,
    saveDressedOutfit,
    saveItemPlacement,
    type SavedDressedOutfit,
  } from "../lib/client/wardrobe-ai";

  type WardrobeItem = {
    id: string;
    name: string;
    category: string;
    originalPath?: string;
    originalPreviewUrl?: string;
    referencePath?: string;
    previewUrl?: string;
    cleanPreviewUrl?: string;
    generationVersion?: number | null;
    baseType?: ClothingBaseType;
    aiReadyAssets?: Partial<Record<ClothingBaseType, ClothingBaseAsset>>;
    placement?: Placement | null;
  };

  const wardrobeModel =
    document.querySelector("#wardrobe-model") as HTMLElement;

  const modelStatus =
    document.querySelector("#model-status") as HTMLElement;

  const clothingGrid =
    document.querySelector("#clothing-grid") as HTMLElement;

  const clothingHeading =
    document.querySelector("#clothing-heading") as HTMLElement;

  const currentOutfitItems =
    document.querySelector("#current-outfit-items") as HTMLElement;

  const outfitMessage =
    document.querySelector("#outfit-message") as HTMLElement;

  const categoryButtons =
    document.querySelector(".category-list") as HTMLElement;

  const savedOutfitsGrid =
    document.querySelector("#saved-outfits-grid") as HTMLElement;

  let activeCategory = "ALL";
  let clothingItems: WardrobeItem[] = [];
  let selectedItems: WardrobeItem[] = [];
  let filterButtons: HTMLButtonElement[] = [];
  let primaryCharacterBaseType: ClothingBaseType | null = null;
  let activeCharacterId: string | null = null;

  function moveSelectedItem(itemId: string, direction: "up" | "down") {
    const currentIndex = selectedItems.findIndex((item) => item.id === itemId);
    const targetIndex = direction === "up" ? currentIndex + 1 : currentIndex - 1;
    if (currentIndex < 0 || targetIndex < 0 || targetIndex >= selectedItems.length) return;
    [selectedItems[currentIndex], selectedItems[targetIndex]] =
      [selectedItems[targetIndex], selectedItems[currentIndex]];
    renderCurrentOutfit();
  }

  function addSelectedItem(item: WardrobeItem) {
    const insertAt = selectedItems.findIndex(
      (selected) => clothingLayerOrder(selected.category) > clothingLayerOrder(item.category)
    );
    if (insertAt === -1) selectedItems.push(item);
    else selectedItems.splice(insertAt, 0, item);
  }

  function setCharacterImage(source: string, alt: string) {
    const canvas = document.createElement("div");
    canvas.className = "dressed-canvas";
    const base = document.createElement("img");
    base.className = "dressed-character-base";
    base.src = source;
    base.alt = alt;
    canvas.appendChild(base);
    const layers = document.createElement("div");
    layers.className = "dressed-clothing-layers";
    layers.setAttribute("aria-hidden", "true");
    canvas.appendChild(layers);
    wardrobeModel.replaceChildren(canvas);
    renderCharacterLayers();
  }

  /* ---- PLACEMENT EDITOR (per-item) -------------------------------------
   * Placement and layering stay INDEPENDENT: this block only writes the
   * per-layer CSS variables the existing transform already consumes
   * (--anchor-x/y, --clothing-scale, --clothing-x/y). Layer order stays
   * owned by selectedItems + clothingLayerOrder (zIndex) and is never
   * touched here. Defaults come from the existing clothingPlacement()
   * (category) + dressedAnchor() (base type / master geometry) system.
   * The AI asset file itself is never modified — only render metadata. */
  type PlacementOverride = {
    anchor: DressedAnchor;
    x: number;
    y: number;
    scale: number;
    // Optional FREE-scaling axes. Contract: both or neither (validated by
    // parsePlacement/sanitizePlacement) — legacy overrides simply omit them.
    scaleX?: number;
    scaleY?: number;
  };

  const PLACEMENT_SCALE_MIN = 0.4;
  const PLACEMENT_SCALE_MAX = 2;
  const PLACEMENT_OFFSET_LIMIT = 60; // percent of canvas, per axis

  const placementOverrides = new Map<string, PlacementOverride>();
  let editingItemId: string | null = null;
  // One placement commit at a time, so a second tap (DONE or the ADJUST toggle)
  // can never start a duplicate PATCH while the first one is still in flight.
  let placementCommitInProgress = false;
  // UI-only session state: which scaling controls the editor shows.
  // NEVER persisted — the stored placement decides rendering; this only decides
  // whether the editor shows the proportional SIZE slider or the FREE
  // WIDTH/HEIGHT sliders for the item currently open.
  let freeScale = false;

  const placementPanel = document.querySelector<HTMLElement>("#placement-panel");
  const placementTitle = document.querySelector<HTMLElement>("#placement-item-name");
  const placementAnchorSelect = document.querySelector<HTMLSelectElement>("#placement-anchor");
  const placementScaleInput = document.querySelector<HTMLInputElement>("#placement-scale");
  const placementScaleValue = document.querySelector<HTMLElement>("#placement-scale-value");
  const placementFreeInput = document.querySelector<HTMLInputElement>("#placement-free");
  const placementFreeFields = document.querySelector<HTMLElement>("#placement-free-fields");
  const placementScaleXInput = document.querySelector<HTMLInputElement>("#placement-scale-x");
  const placementScaleYInput = document.querySelector<HTMLInputElement>("#placement-scale-y");
  const placementScaleXValue = document.querySelector<HTMLElement>("#placement-scale-x-value");
  const placementScaleYValue = document.querySelector<HTMLElement>("#placement-scale-y-value");
  const placementReadout = document.querySelector<HTMLElement>("#placement-readout");
  const placementResetButton = document.querySelector<HTMLButtonElement>("#placement-reset");
  const placementDoneButton = document.querySelector<HTMLButtonElement>("#placement-done");

  // Anchor options come from the EXISTING anchor table only (no new anchors).
  Object.keys(DRESSED_ANCHORS).forEach((anchorKey) => {
    const option = document.createElement("option");
    option.value = anchorKey;
    option.textContent = anchorKey.toUpperCase();
    placementAnchorSelect?.appendChild(option);
  });

  function resolveLayerPlacement(item: WardrobeItem): PlacementOverride {
    // session override -> persisted item placement -> existing category default
    return resolveItemPlacement({
      category: item.category,
      persistedPlacement: item.placement,
      sessionOverride: placementOverrides.get(item.id),
    });
  }

  function placementLayerElement(itemId: string): HTMLElement | null {
    return wardrobeModel.querySelector<HTMLElement>(
      `.dressed-clothing-layer[data-item-id="${CSS.escape(itemId)}"]`
    );
  }

  function applyLayerPlacement(item: WardrobeItem, layer: HTMLElement) {
    const placement = resolveLayerPlacement(item);
    const anchorPoint = dressedAnchor(placement.anchor, primaryCharacterBaseType);
    layer.dataset.anchor = placement.anchor;
    layer.style.setProperty("--anchor-x", String(anchorPoint.x));
    layer.style.setProperty("--anchor-y", String(anchorPoint.y));
    layer.style.setProperty("--clothing-scale", String(placement.scale));
    // Effective X/Y axes: for legacy placements both equal placement.scale, so
    // the CSS transform renders exactly as the old single-value scale().
    layer.style.setProperty("--clothing-scale-x", String(effectiveScaleX(placement)));
    layer.style.setProperty("--clothing-scale-y", String(effectiveScaleY(placement)));
    layer.style.setProperty("--clothing-x", `${placement.x}%`);
    layer.style.setProperty("--clothing-y", `${placement.y}%`);
    layer.classList.toggle("dressed-clothing-layer--editing", item.id === editingItemId);
  }

  function setPlacementOverride(itemId: string, patch: Partial<PlacementOverride>) {
    const item = selectedItems.find((entry) => entry.id === itemId);
    if (!item) return;
    const next = { ...resolveLayerPlacement(item), ...patch };
    next.scale = Math.min(PLACEMENT_SCALE_MAX, Math.max(PLACEMENT_SCALE_MIN, next.scale));
    next.x = Math.min(PLACEMENT_OFFSET_LIMIT, Math.max(-PLACEMENT_OFFSET_LIMIT, next.x));
    next.y = Math.min(PLACEMENT_OFFSET_LIMIT, Math.max(-PLACEMENT_OFFSET_LIMIT, next.y));
    // FREE axes share the same clamp range as `scale` (spec §10).
    if (next.scaleX !== undefined) {
      next.scaleX = Math.min(PLACEMENT_SCALE_MAX, Math.max(PLACEMENT_SCALE_MIN, next.scaleX));
    }
    if (next.scaleY !== undefined) {
      next.scaleY = Math.min(PLACEMENT_SCALE_MAX, Math.max(PLACEMENT_SCALE_MIN, next.scaleY));
    }
    placementOverrides.set(itemId, next);
    const layer = placementLayerElement(itemId);
    if (layer) applyLayerPlacement(item, layer);
    if (itemId === editingItemId) updatePlacementPanel();
  }

  /* Persistence happens ONLY on DONE, on an ADJUST-toggle close and on RESET —
     never during drag or slider input. The write goes through the authenticated
     wardrobe API (owner-RLS UPDATE of the placement column alone). If it fails —
     for example the placement migration has not been applied yet — the session
     value is kept and only an error is reported, so the editor keeps working and
     defaults stay untouched.

     Returns true when it is safe to close the editor: the value was written, or
     there was provably nothing to write. Returns false only when the server
     rejected the write, so the caller can keep the editor (and the session
     placement) open instead of hiding the failure. */
  async function persistItemPlacement(
    itemId: string,
    placement: Placement | null
  ): Promise<boolean> {
    const item = clothingItems.find((entry) => entry.id === itemId);
    if (!item || !supabase) return true;
    if (placement === null) {
      if (item.placement == null) return true; // already permanently at the default
    } else if (isSamePlacement(item.placement, placement)) {
      return true; // nothing changed — skip the write
    }
    try {
      const { data: session, error } = await supabase.auth.getSession();
      const accessToken = session.session?.access_token;
      if (error || !accessToken) {
        throw new Error(error?.message ?? "No active session.");
      }
      await saveItemPlacement(accessToken, itemId, placement);
      item.placement = placement;
      outfitMessage.textContent = "PLACEMENT SAVED.";
      return true;
    } catch (error) {
      console.error("Could not persist this placement.", error);
      outfitMessage.textContent =
        "PLACEMENT COULD NOT BE SAVED. IT STILL APPLIES FOR THIS SESSION.";
      return false;
    }
  }

  /* Shared commit used by DONE and by the ADJUST-toggle close: read the current
     session override, validate it with the SAME parsePlacement the DONE flow
     already used, persist it through the SAME PATCH, and report whether it is
     safe to close. Unchanged placements are skipped inside persistItemPlacement
     (isSamePlacement), so opening and closing the editor costs no request. */
  async function commitPlacementOverride(itemId: string): Promise<boolean> {
    if (placementCommitInProgress) return false;
    const placement = parsePlacement(placementOverrides.get(itemId));
    if (!placement) return true; // never changed / nothing valid to save
    placementCommitInProgress = true;
    try {
      const saved = await persistItemPlacement(itemId, placement);
      if (saved) {
        // parsePlacement rounds to 4 decimals, so the stored value can differ
        // from the raw session value. Re-seat the override on the exact value
        // that was written: the session override and the database row stay
        // byte-identical and the resolver can never render two different values.
        placementOverrides.set(itemId, placement);
      }
      return saved;
    } finally {
      placementCommitInProgress = false;
    }
  }

  function updatePlacementPanel() {
    const item = editingItemId
      ? selectedItems.find((entry) => entry.id === editingItemId)
      : undefined;
    if (
      !item ||
      !placementPanel ||
      !placementTitle ||
      !placementAnchorSelect ||
      !placementScaleInput ||
      !placementScaleValue ||
      !placementReadout
    ) {
      closePlacementEditor();
      return;
    }
    const placement = resolveLayerPlacement(item);
    placementTitle.textContent = item.name.toUpperCase();
    placementAnchorSelect.value = placement.anchor;
    placementScaleInput.value = String(placement.scale);
    placementScaleValue.textContent = `${placement.scale.toFixed(2)}x`;
    // FREE controls show the EFFECTIVE axes (scaleX ?? scale), so the sliders
    // always reflect what actually renders — even before any axis override exists.
    const effectiveX = effectiveScaleX(placement);
    const effectiveY = effectiveScaleY(placement);
    if (placementFreeInput) placementFreeInput.checked = freeScale;
    if (placementFreeFields) placementFreeFields.hidden = !freeScale;
    // SIZE slider is hidden in FREE mode (its `scale` would not affect rendering
    // while axes exist); the SIZE label+value stays visible as the canonical
    // proportional value that wheel/pinch still write (spec §3).
    if (placementScaleXInput) placementScaleXInput.value = String(effectiveX);
    if (placementScaleYInput) placementScaleYInput.value = String(effectiveY);
    if (placementScaleXValue) placementScaleXValue.textContent = `${Math.round(effectiveX * 100)}%`;
    if (placementScaleYValue) placementScaleYValue.textContent = `${Math.round(effectiveY * 100)}%`;
    placementScaleInput.hidden = freeScale;
    placementReadout.textContent = freeScale
      ? `X ${placement.x.toFixed(1)}%   Y ${placement.y.toFixed(1)}%   W ${Math.round(effectiveX * 100)}% / H ${Math.round(effectiveY * 100)}%`
      : `X ${placement.x.toFixed(1)}%   Y ${placement.y.toFixed(1)}%   SIZE ${placement.scale.toFixed(2)}x`;
  }

  function renderCharacterLayers() {
    const layers = wardrobeModel.querySelector<HTMLElement>(".dressed-clothing-layers");
    if (!layers) return;
    layers.replaceChildren();
    const baseType = primaryCharacterBaseType;
    if (!baseType) return;

    selectedItems
      .map((item) => ({
        item,
        asset: item.aiReadyAssets?.[baseType],
      }))
      .filter(({ asset }) =>
        asset?.generationVersion === CURRENT_CLOTHING_ASSET_VERSION &&
        Boolean(asset.referencePath && asset.previewUrl)
      )
      .forEach(({ item, asset }, index) => {
        const layer = document.createElement("img");
        layer.className = "dressed-clothing-layer";
        layer.src = asset!.previewUrl;
        layer.alt = "";
        layer.dataset.itemId = item.id;
        layer.style.zIndex = String(index + 1);
        applyLayerPlacement(item, layer);
        layers.appendChild(layer);
      });
  }

  function openPlacementEditor(itemId: string) {
    if (!selectedItems.some((entry) => entry.id === itemId)) return;
    editingItemId = itemId;
    // FREE controls follow the DATA (spec §9): an item stored with scaleX/scaleY
    // reopens in FREE mode; a legacy 4-key item reopens proportional. Recomputed
    // on every open — freeScale is session-only and never persisted.
    const openedItem = selectedItems.find((entry) => entry.id === itemId);
    freeScale = Boolean(openedItem && resolveLayerPlacement(openedItem).scaleX !== undefined);
    if (placementPanel) placementPanel.hidden = false;
    renderCurrentOutfit();
    renderCharacterLayers();
    updatePlacementPanel();
  }

  function closePlacementEditor() {
    const previousId = editingItemId;
    editingItemId = null;
    freeScale = false;
    if (placementPanel) placementPanel.hidden = true;
    if (previousId) {
      placementLayerElement(previousId)?.classList.remove("dressed-clothing-layer--editing");
      const button = currentOutfitItems.querySelector<HTMLButtonElement>(
        `.adjust-outfit-item[data-item-id="${CSS.escape(previousId)}"]`
      );
      if (button) {
        button.setAttribute("aria-pressed", "false");
        button.textContent = "ADJUST";
      }
    }
  }

  placementAnchorSelect?.addEventListener("change", () => {
    if (editingItemId) {
      setPlacementOverride(editingItemId, {
        anchor: placementAnchorSelect.value as DressedAnchor,
      });
    }
  });

  placementScaleInput?.addEventListener("input", () => {
    if (editingItemId) {
      setPlacementOverride(editingItemId, { scale: Number(placementScaleInput.value) });
    }
  });

  /* ---- FREE SCALING (spec §9–§11) --------------------------------------
     freeScale is pure UI state: entering FREE writes NOTHING until a
     WIDTH/HEIGHT slider actually moves, so toggling on/off without edits can
     never produce a PATCH. Leaving FREE strips any axes from the session
     override, so DONE saves the legacy {anchor,x,y,scale} form and rendering
     falls back to proportional (spec §10). */
  placementFreeInput?.addEventListener("change", () => {
    if (!editingItemId) {
      placementFreeInput.checked = false;
      freeScale = false;
      return;
    }
    const itemId = editingItemId;
    const item = selectedItems.find((entry) => entry.id === itemId);
    if (!item) return;
    freeScale = placementFreeInput.checked;
    if (!freeScale) {
      const current = resolveLayerPlacement(item);
      if (current.scaleX !== undefined || current.scaleY !== undefined) {
        // Drop BOTH axes, keep anchor/x/y/scale untouched. Writing the full
        // object (instead of merging) is what removes the axis keys.
        placementOverrides.set(itemId, {
          anchor: current.anchor,
          x: current.x,
          y: current.y,
          scale: current.scale,
        });
        const layer = placementLayerElement(itemId);
        if (layer) applyLayerPlacement(item, layer);
      }
      // No axes anywhere → no override is created → DONE stays a no-op.
    }
    updatePlacementPanel();
  });

  /* WIDTH/HEIGHT always write BOTH axes together (contract: never a single
     axis alone). The untouched axis keeps its current EFFECTIVE value, so
     moving WIDTH alone leaves the visible height unchanged. */
  placementScaleXInput?.addEventListener("input", () => {
    if (!editingItemId || !freeScale) return;
    const item = selectedItems.find((entry) => entry.id === editingItemId);
    if (!item) return;
    const current = resolveLayerPlacement(item);
    setPlacementOverride(editingItemId, {
      scaleX: Number(placementScaleXInput.value),
      scaleY: current.scaleY ?? current.scale,
    });
  });

  placementScaleYInput?.addEventListener("input", () => {
    if (!editingItemId || !freeScale) return;
    const item = selectedItems.find((entry) => entry.id === editingItemId);
    if (!item) return;
    const current = resolveLayerPlacement(item);
    setPlacementOverride(editingItemId, {
      scaleY: Number(placementScaleYInput.value),
      scaleX: current.scaleX ?? current.scale,
    });
  });

  placementResetButton?.addEventListener("click", () => {
    void (async () => {
      if (!editingItemId) return;
      const resetItemId = editingItemId;
      placementOverrides.delete(resetItemId);
      const item = selectedItems.find((entry) => entry.id === resetItemId);
      const layer = placementLayerElement(resetItemId);
      // RESET is permanent: start the placement=null write while the previous
      // stored value is still known to persistItemPlacement, then clear the
      // local value so the existing defaults render immediately. The clothing
      // item itself is never touched. The write is awaited (it never rejects),
      // but the local reset stays synchronous so the visible order is unchanged.
      const persisted = persistItemPlacement(resetItemId, null);
      if (item) item.placement = null;
      if (item && layer) applyLayerPlacement(item, layer);
      updatePlacementPanel();
      await persisted;
    })();
  });

  placementDoneButton?.addEventListener("click", () => {
    void (async () => {
      if (!editingItemId || placementCommitInProgress) return;
      const completedItemId = editingItemId;
      // Await the write BEFORE closing: a failed PATCH must not be hidden by
      // an editor that simply disappears (the session placement stays intact).
      const saved = await commitPlacementOverride(completedItemId);
      if (!saved) return;
      closePlacementEditor();
      renderCurrentOutfit();
    })();
  });

  /* Live drag of the ACTIVE layer. Deltas are converted to canvas percent
     (the layer img is exactly the canvas box, so translate() percentages
     map 1:1 to canvas movement). Uniform scale() in CSS guarantees the
     aspect ratio can never break. Only the editing layer has pointer
     events, so dragging can never reorder or touch other layers.
     Mouse, pen and touch all run through this one Pointer Events path;
     touch-action:none on the editing layer (stylesheet) keeps the browser
     from turning the drag into a page scroll, exactly one active pointer id
     steers the drag, so a second finger can never jump the garment. */
  type PlacementDrag = {
    pointerId: number;
    layer: HTMLElement;
    startX: number;
    startY: number;
    startClientX: number;
    startClientY: number;
    rect: DOMRect;
  };
  let placementDrag: PlacementDrag | null = null;

  /* Gesture inputs that feed the SAME placement.scale the scale slider writes
     (desktop = hold LEFT button on the active item + wheel; mobile = pinch
     with two fingers that both begin on the active item). There is no zoom
     state: every path below goes through setPlacementOverride, so one
     placement value, one clamp, one persistence flow (DONE -> PATCH).
     pinchPointers holds live positions of pointers that began ON the active
     editing layer; placementPinch is set once two of them are down. */
  type PlacementPinch = {
    ids: number[];
    startDistance: number;
    startScale: number;
  };
  let placementPinch: PlacementPinch | null = null;
  const pinchPointers = new Map<number, { x: number; y: number }>();
  // True once the wheel has scaled during the current left-button hold so
  // pointer jitter cannot shift x/y while the user is wheel-scaling.
  let wheelScaleActive = false;

  /* ---- TAP-TO-SELECT (spec §14–§16: TAP = SELECT, DRAG = MOVE) -----------
     Single-item selection reuses editingItemId — there is NO second selection
     state. The pointer-events model is deliberately UNCHANGED: only the
     --editing layer receives events, so drag/pinch keep working even when
     another garment box overlaps the selected one (making every layer
     pointer-events:auto would let the topmost full-canvas box swallow the
     presses meant for the selected layer underneath — §17 answered: not safe).
     Instead the garment under a press is found by a manual topmost-box test,
     and the candidate is committed ONLY on pointerup with ≤ TAP_SLOP_PX
     movement: a real drag or a page scroll cancels it, and a second finger
     turns the gesture into a non-tap. Nothing here calls preventDefault,
     setPointerCapture or starts a drag/pinch. */
  type PlacementTapCandidate = {
    pointerId: number;
    x: number;
    y: number;
    itemId: string | null;
    valid: boolean;
  };
  let tapCandidate: PlacementTapCandidate | null = null;
  const TAP_SLOP_PX = 8; // beyond this a press is a drag/scroll, never a tap

  /* Topmost garment box containing the point. Layers are appended in
     z-index order (index + 1), so testing from the END finds the visually
     topmost layer first. Boxes are the transformed layer boxes — items behind
     the topmost one are selected through the existing outfit list (§19). */
  function clothingLayerAtPoint(clientX: number, clientY: number): string | null {
    const layers = wardrobeModel.querySelectorAll<HTMLElement>(".dressed-clothing-layer");
    for (let index = layers.length - 1; index >= 0; index -= 1) {
      const layer = layers.item(index);
      if (!layer) continue;
      const rect = layer.getBoundingClientRect();
      if (
        clientX >= rect.left &&
        clientX <= rect.right &&
        clientY >= rect.top &&
        clientY <= rect.bottom
      ) {
        return layer.dataset.itemId ?? null;
      }
    }
    return null;
  }

  wardrobeModel.addEventListener("pointerdown", (event) => {
    if (event.button !== 0) return;
    // Record a tap-to-select candidate for EVERY press on the model. It is
    // committed on pointerup only (see endPlacementPointer) and cancelled by
    // movement > TAP_SLOP_PX. A second finger simply overwrites the candidate:
    // the first finger's pointerup then fails the pointerId match (no select),
    // and any pinch movement invalidates the survivor. This branch never calls
    // preventDefault and never touches placementDrag/pinchPointers.
    tapCandidate = {
      pointerId: event.pointerId,
      x: event.clientX,
      y: event.clientY,
      itemId: clothingLayerAtPoint(event.clientX, event.clientY),
      valid: true,
    };
    if (!editingItemId) return;
    const target = event.target instanceof Element ? event.target : null;
    const layer = target?.closest<HTMLElement>(".dressed-clothing-layer--editing");
    const layersElement = wardrobeModel.querySelector<HTMLElement>(".dressed-clothing-layers");
    const item = selectedItems.find((entry) => entry.id === editingItemId);
    if (!layer || !layersElement || !item) return;
    // Track pointers that begin ON the active item — the mobile pinch only
    // considers pointers that started on the editing layer.
    if (!placementPinch && pinchPointers.size < 2 && !pinchPointers.has(event.pointerId)) {
      pinchPointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
    }
    if (!placementPinch && pinchPointers.size === 2) {
      const [first, second] = Array.from(pinchPointers.values());
      const distance = Math.hypot(second.x - first.x, second.y - first.y);
      if (distance > 0) {
        // Two fingers on the item = pinch. It only ever writes { scale }:
        // setPlacementOverride merges into the current placement, so x, y,
        // anchor and layer/z-index stay untouched and the shared
        // PLACEMENT_SCALE_MIN..MAX clamp applies.
        placementPinch = {
          ids: Array.from(pinchPointers.keys()),
          startDistance: distance,
          startScale: resolveLayerPlacement(item).scale,
        };
        if (placementDrag) {
          // One gesture at a time: stop the single-finger drag. The finger
          // keeps its pointer capture until it lifts, so no lostpointercapture
          // fires here and the pinch is not cancelled immediately.
          placementDrag.layer.classList.remove("is-dragging");
          placementDrag = null;
        }
        event.preventDefault();
        return;
      }
    }
    if (placementDrag || placementPinch) return;
    const current = resolveLayerPlacement(item);
    placementDrag = {
      pointerId: event.pointerId,
      layer,
      startX: current.x,
      startY: current.y,
      startClientX: event.clientX,
      startClientY: event.clientY,
      rect: layersElement.getBoundingClientRect(),
    };
    layer.classList.add("is-dragging");
    try {
      layer.setPointerCapture(event.pointerId);
    } catch {
      // Capture is best-effort; the bubbling handlers below still drive the drag.
    }
    event.preventDefault();
  });

  wardrobeModel.addEventListener("pointermove", (event) => {
    // Any real movement cancels the tap-to-select candidate: a drag or a page
    // scroll must never change the selection (TAP = SELECT, DRAG = MOVE).
    if (tapCandidate && tapCandidate.valid && tapCandidate.pointerId === event.pointerId) {
      const moved = Math.hypot(event.clientX - tapCandidate.x, event.clientY - tapCandidate.y);
      if (moved > TAP_SLOP_PX) tapCandidate.valid = false;
    }
    if (pinchPointers.has(event.pointerId)) {
      pinchPointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
    }
    if (placementPinch) {
      if (!editingItemId || placementPinch.ids.indexOf(event.pointerId) === -1) return;
      const first = pinchPointers.get(placementPinch.ids[0]);
      const second = pinchPointers.get(placementPinch.ids[1]);
      if (!first || !second) return;
      const distance = Math.hypot(second.x - first.x, second.y - first.y);
      if (distance <= 0) return;
      // Distance ratio scales placement.scale ONLY — x, y, anchor and layer
      // are never patched here, and the shared clamp lives in setPlacementOverride.
      setPlacementOverride(editingItemId, {
        scale: placementPinch.startScale * (distance / placementPinch.startDistance),
      });
      return;
    }
    if (!placementDrag || event.pointerId !== placementDrag.pointerId || !editingItemId || wheelScaleActive) return;
    const { rect, startClientX, startClientY, startX, startY } = placementDrag;
    if (rect.width <= 0 || rect.height <= 0) return;
    const deltaX = ((event.clientX - startClientX) / rect.width) * 100;
    const deltaY = ((event.clientY - startClientY) / rect.height) * 100;
    setPlacementOverride(editingItemId, { x: startX + deltaX, y: startY + deltaY });
  });

  const endPlacementDrag = (event: PointerEvent) => {
    if (!placementDrag || event.pointerId !== placementDrag.pointerId) return;
    try {
      placementDrag.layer.releasePointerCapture(event.pointerId);
    } catch {
      // The browser may have already released the capture (pointercancel).
    }
    placementDrag.layer.classList.remove("is-dragging");
    placementDrag = null;
  };
  const endPlacementPointer = (event: PointerEvent) => {
    // Snapshot the tap candidate BEFORE any cleanup and commit it FIRST: the
    // drag cleanup below can re-enter this handler (releasing pointer capture
    // or re-rendering layers fires lostpointercapture), and by then the
    // candidate is already consumed. pointercancel / lostpointercapture /
    // moved-too-far / second finger / wheel-scale all leave the candidate
    // invalid or unmatched, so a drag, a pinch, a wheel gesture or a page
    // scroll can never change the selection.
    const candidate = tapCandidate;
    tapCandidate = null;
    const wasWheelScaling = wheelScaleActive;
    const dragStart =
      placementDrag && placementDrag.pointerId === event.pointerId
        ? { itemId: editingItemId, x: placementDrag.startX, y: placementDrag.startY }
        : null;
    if (
      event.type === "pointerup" &&
      candidate &&
      candidate.valid &&
      candidate.pointerId === event.pointerId &&
      candidate.itemId &&
      candidate.itemId !== editingItemId &&
      !wasWheelScaling &&
      Math.hypot(event.clientX - candidate.x, event.clientY - candidate.y) <= TAP_SLOP_PX
    ) {
      // A tap that also armed a (sub-slop) drag must not leave pointer jitter
      // behind on the item we are deselecting: restore its pre-press x/y.
      if (dragStart && dragStart.itemId) {
        const previous = selectedItems.find((entry) => entry.id === dragStart.itemId);
        if (previous) {
          const current = resolveLayerPlacement(previous);
          if (current.x !== dragStart.x || current.y !== dragStart.y) {
            setPlacementOverride(dragStart.itemId, { x: dragStart.x, y: dragStart.y });
          }
        }
      }
      // editingItemId is the ONLY selection state — this just re-opens the
      // editor for the garment under the tap (same mechanism as the ADJUST
      // button in the outfit list).
      openPlacementEditor(candidate.itemId);
    }
    endPlacementDrag(event);
    if (pinchPointers.has(event.pointerId)) pinchPointers.delete(event.pointerId);
    if (
      placementPinch &&
      (placementPinch.ids.indexOf(event.pointerId) >= 0 || pinchPointers.size < 2)
    ) {
      // the pinch ends as soon as either finger lifts
      placementPinch = null;
    }
    wheelScaleActive = false;
  };
  wardrobeModel.addEventListener("pointerup", endPlacementPointer);
  wardrobeModel.addEventListener("pointercancel", endPlacementPointer);
  // A re-render or an implicit browser release drops the capture without a
  // pointerup; clearing through this event keeps the drag state consistent.
  wardrobeModel.addEventListener("lostpointercapture", endPlacementPointer);

  /* Desktop wheel = the SAME placement.scale the scale slider writes. It only
     engages while the LEFT button is held ON the active item (placementDrag is
     set exactly when the press began on the editing layer) and only when the
     wheel cursor is over that item. Wheel without the button — or anywhere
     outside the active item — keeps normal browser behaviour: preventDefault()
     runs only on the branch we handle. No zoom/canvas state exists; DONE
     persists through the existing placement PATCH. */
  const WHEEL_SCALE_RATE = 0.0005; // scale per wheel pixel: a ~100px notch ≈ 0.05
  wardrobeModel.addEventListener(
    "wheel",
    (event) => {
      if (!placementDrag || !editingItemId) return;
      const target = event.target instanceof Element ? event.target : null;
      if (!target?.closest(".dressed-clothing-layer--editing")) return;
      if (event.deltaY === 0) return;
      const item = selectedItems.find((entry) => entry.id === editingItemId);
      if (!item) return;
      event.preventDefault(); // only the handled case consumes the wheel
      wheelScaleActive = true; // pointer jitter must not shift x/y during the hold
      const delta =
        event.deltaMode === 1 ? event.deltaY * 16
        : event.deltaMode === 2 ? event.deltaY * 400
        : event.deltaY;
      // wheel up (deltaY < 0) = larger; the shared clamp lives below in
      // setPlacementOverride (PLACEMENT_SCALE_MIN..MAX).
      setPlacementOverride(editingItemId, {
        scale: resolveLayerPlacement(item).scale - delta * WHEEL_SCALE_RATE,
      });
    },
    { passive: false }
  );

  function isSafeImage(value: string) {
    return value.startsWith("data:image/") ||
      value.startsWith("https://") ||
      value.startsWith("http://");
  }

  function renderCategoryFilters() {
    for (const category of CLOTHING_CATEGORIES) {
      const button = document.createElement("button");
      button.type = "button";
      button.className = "category-button";
      button.dataset.category = category.value.toUpperCase();
      button.textContent = category.label.toUpperCase();
      button.setAttribute("aria-pressed", "false");
      categoryButtons.appendChild(button);
    }
    filterButtons = Array.from(categoryButtons.querySelectorAll<HTMLButtonElement>(".category-button"));
    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        activeCategory = button.dataset.category || "ALL";
        filterButtons.forEach((candidate) => {
          const active = candidate === button;
          candidate.classList.toggle("category-button--active", active);
          candidate.setAttribute("aria-pressed", String(active));
        });
        renderClothingItems();
      });
    });
  }

  function loadLegacySourcePhoto() {
    const sourcePhoto = localStorage.getItem("closet-source-photo");

    if (!sourcePhoto || !isSafeImage(sourcePhoto)) {
      modelStatus.textContent = "NO DRESSED CHARACTER YET";
      return;
    }

    setCharacterImage(sourcePhoto, "Uploaded source photo (not an AI-generated model)");
    modelStatus.textContent = "UPLOADED SOURCE PHOTO — NOT AN AI MODEL";
  }

  async function loadPrimaryCharacter() {
    if (!supabase) return;
    const { data: session, error: sessionError } = await supabase.auth.getSession();
    if (sessionError || !session.session) return;
    const userId = session.session.user.id;
    const { data: profile, error } = await supabase
      .from("profiles")
      .select("gender, model_photo_path, source_photo_path")
      .eq("user_id", userId)
      .maybeSingle();
    if (error) {
      console.error("Could not load the primary DRESSED character.", error);
      modelStatus.textContent = "COULD NOT LOAD YOUR DRESSED CHARACTER.";
      return;
    }
    const { data: primaryCharacter, error: characterError } = await supabase
      .from("dressed_characters")
      .select("id, gender, model_path, geometry_contract_version")
      .eq("user_id", userId)
      .eq("is_primary", true)
      .maybeSingle();
    if (characterError) {
      console.error("Could not load the saved primary DRESSED character.", characterError);
      modelStatus.textContent = "COULD NOT LOAD YOUR DRESSED CHARACTER.";
      return;
    }
    if (
      primaryCharacter &&
      primaryCharacter.geometry_contract_version !== DRESSED_GEOMETRY_CONTRACT_VERSION
    ) {
      modelStatus.textContent =
        "THIS CHARACTER USES LEGACY BODY GEOMETRY. GENERATE A NEW CHARACTER TO USE AI-READY CLOTHING.";
      return;
    }
    if (primaryCharacter && !primaryCharacter.model_path.startsWith(`${userId}/`)) {
      console.error("The primary DRESSED character has an invalid image path.");
      modelStatus.textContent = "YOUR PRIMARY DRESSED CHARACTER IMAGE IS INVALID.";
      return;
    }
    if (!primaryCharacter && profile?.model_photo_path) {
      modelStatus.textContent =
        "GENERATE A NEW CHARACTER ON YOUR PROFILE TO USE GEOMETRY-COMPATIBLE AI-READY CLOTHING.";
      return;
    }
    const profileGender =
      profile?.gender === "woman" || profile?.gender === "man" ? profile.gender : null;
    if (
      profileGender &&
      primaryCharacter &&
      primaryCharacter.gender !== profileGender
    ) {
      console.error("The primary character does not match the locked profile model type.");
      modelStatus.textContent = "YOUR SAVED CHARACTER DOES NOT MATCH YOUR MODEL TYPE.";
      return;
    }
    const characterGender =
      profileGender ??
      (primaryCharacter?.gender === "woman" || primaryCharacter?.gender === "man"
        ? primaryCharacter.gender
        : null);
    primaryCharacterBaseType =
      primaryCharacter?.gender === "woman" || primaryCharacter?.gender === "man"
        ? primaryCharacter.gender
        : null;
    activeCharacterId = primaryCharacter?.id ?? null;
    const modelPhotoPath = primaryCharacter?.model_path ?? null;

    if (modelPhotoPath) {
      const cache = readDressedCharacterCache();
      const cachedImage =
        cache &&
        cache.modelPhotoPath === modelPhotoPath &&
        cache.gender === characterGender
          ? cache.imageDataUrl
          : null;
      if (cachedImage) {
        setCharacterImage(cachedImage, "Your saved DRESSED character");
        modelStatus.textContent = "YOUR PRIMARY DRESSED CHARACTER IS READY.";
        return;
      }
      const { data: signed, error: signedError } = await supabase.storage
        .from("model-images")
        .createSignedUrl(modelPhotoPath, 60 * 60);
      if (signedError || !signed) {
        console.error("Could not create a private character preview URL.", signedError);
        modelStatus.textContent = "COULD NOT LOAD YOUR DRESSED CHARACTER.";
        return;
      }
      setCharacterImage(signed.signedUrl, "Your saved DRESSED character");
      modelStatus.textContent = "YOUR PRIMARY DRESSED CHARACTER IS READY.";
      if (characterGender) {
        void cacheDressedCharacter({
          signedUrl: signed.signedUrl,
          modelPhotoPath,
          gender: characterGender,
        });
      }
      return;
    }
    if (profile?.source_photo_path?.startsWith(`${userId}/`)) {
      const { data: signed, error: signedError } = await supabase.storage
        .from("profile-images")
        .createSignedUrl(profile.source_photo_path, 60 * 60);
      if (!signedError && signed) {
        setCharacterImage(signed.signedUrl, "Uploaded source photo (not a DRESSED character)");
        modelStatus.textContent = "SOURCE PHOTO SAVED — GENERATE YOUR CHARACTER ON PROFILE.";
        return;
      }
      console.error("Could not create a private source-photo preview URL.", signedError);
    }
    loadLegacySourcePhoto();
  }

  function renderCurrentOutfit() {
    if (editingItemId && !selectedItems.some((item) => item.id === editingItemId)) {
      closePlacementEditor();
    }
    currentOutfitItems.replaceChildren();

    if (selectedItems.length === 0) {
      const emptyMessage = document.createElement("p");
      emptyMessage.className = "outfit-empty";
      emptyMessage.textContent = "Select clothes above to start your outfit.";
      currentOutfitItems.appendChild(emptyMessage);
      renderCharacterLayers();
      return;
    }

    selectedItems.forEach((item) => {
      const outfitItem = document.createElement("div");
      outfitItem.className = "current-outfit-item";

      const imageSource = item.cleanPreviewUrl || item.originalPreviewUrl;
      if (imageSource) {
        const image = document.createElement("img");
        image.src = imageSource;
        image.alt = "";
        image.loading = "lazy";
        outfitItem.appendChild(image);
      } else {
        const noImage = document.createElement("span");
        noImage.className = "outfit-no-image";
        noImage.textContent = "NO IMAGE";
        outfitItem.appendChild(noImage);
      }

      const itemName = document.createElement("span");
      itemName.className = "current-outfit-item-name";
      itemName.textContent = item.name;

      const layerIndex = selectedItems.findIndex((selected) => selected.id === item.id);
      const layerControls = document.createElement("div");
      layerControls.className = "outfit-layer-controls";

      const moveUpButton = document.createElement("button");
      moveUpButton.type = "button";
      moveUpButton.className = "move-outfit-item";
      moveUpButton.textContent = "↑";
      moveUpButton.disabled = layerIndex === selectedItems.length - 1;
      moveUpButton.setAttribute("aria-label", `Move ${item.name} up one clothing layer`);
      moveUpButton.title = "Move layer up";
      moveUpButton.addEventListener("click", () => moveSelectedItem(item.id, "up"));

      const moveDownButton = document.createElement("button");
      moveDownButton.type = "button";
      moveDownButton.className = "move-outfit-item";
      moveDownButton.textContent = "↓";
      moveDownButton.disabled = layerIndex === 0;
      moveDownButton.setAttribute("aria-label", `Move ${item.name} down one clothing layer`);
      moveDownButton.title = "Move layer down";
      moveDownButton.addEventListener("click", () => moveSelectedItem(item.id, "down"));

      const removeButton = document.createElement("button");
      removeButton.type = "button";
      removeButton.className = "remove-outfit-item";
      removeButton.textContent = "×";
      removeButton.setAttribute("aria-label", `Remove ${item.name} from current outfit`);
      removeButton.addEventListener("click", () => {
        selectedItems = selectedItems.filter((selected) => selected.id !== item.id);
        renderCurrentOutfit();
        renderClothingItems();
      });

      const adjustButton = document.createElement("button");
      adjustButton.type = "button";
      adjustButton.className = "adjust-outfit-item";
      adjustButton.dataset.itemId = item.id;
      const isAdjusting = editingItemId === item.id;
      adjustButton.textContent = isAdjusting ? "ADJUSTING" : "ADJUST";
      adjustButton.setAttribute("aria-pressed", String(isAdjusting));
      adjustButton.setAttribute("aria-label", `Adjust placement of ${item.name}`);
      adjustButton.addEventListener("click", () => {
        if (editingItemId === item.id) {
          // Closing through the ADJUST toggle commits the pending placement
          // first (same helper and same PATCH as DONE), so an adjustment that
          // is closed here is persisted instead of silently session-only.
          void (async () => {
            if (placementCommitInProgress) return;
            const closingItemId = item.id;
            const saved = await commitPlacementOverride(closingItemId);
            if (!saved) return; // keep the editor and the session placement open
            closePlacementEditor();
            renderCurrentOutfit();
          })();
        } else {
          openPlacementEditor(item.id);
        }
      });

      layerControls.append(moveUpButton, moveDownButton, removeButton);
      outfitItem.append(itemName, layerControls, adjustButton);
      currentOutfitItems.appendChild(outfitItem);
    });
    renderCharacterLayers();
  }

  function renderClothingItems() {
    const visibleItems = activeCategory === "ALL"
      ? clothingItems
      : clothingItems.filter((item) => item.category === activeCategory);

    clothingHeading.textContent = activeCategory === "ALL"
      ? "ALL ITEMS"
      : activeCategory;
    clothingGrid.replaceChildren();

    if (visibleItems.length === 0) {
      const emptyMessage = document.createElement("div");
      emptyMessage.className = "clothing-empty";

      const message = document.createElement("p");
      message.textContent = clothingItems.length === 0 && activeCategory === "ALL"
        ? "YOUR CLOSET IS EMPTY"
        : "NO ITEMS IN THIS CATEGORY";

      const link = document.createElement("a");
      link.href = "/profile";
      link.textContent = "ADD CLOTHING IN YOUR PROFILE";

      emptyMessage.append(message, link);
      clothingGrid.appendChild(emptyMessage);
      return;
    }

    visibleItems.forEach((item) => {
      const card = document.createElement("article");
      card.className = "clothing-item";

      if (selectedItems.some((selected) => selected.id === item.id)) {
        card.classList.add("clothing-item--selected");
      }

      const imageSource = item.cleanPreviewUrl || item.originalPreviewUrl;
      if (imageSource) {
        const image = document.createElement("img");
        image.className = "clothing-item-image";
        image.src = imageSource;
        image.alt = item.name;
        image.loading = "lazy";
        card.appendChild(image);
      } else {
        const noImage = document.createElement("span");
        noImage.className = "clothing-item-no-image";
        noImage.textContent = "NO IMAGE";
        card.appendChild(noImage);
      }

      const category = document.createElement("small");
      category.className = "clothing-item-category";
      const normalizedCategory = normalizeClothingCategory(item.category) ?? "other";
      category.textContent = categoryLabel(normalizedCategory).toUpperCase();

      const name = document.createElement("strong");
      name.className = "clothing-item-name";
      name.textContent = item.name;
      const readiness = document.createElement("small");
      readiness.className = "clothing-item-readiness";
      const activeAsset = primaryCharacterBaseType
        ? item.aiReadyAssets?.[primaryCharacterBaseType]
        : undefined;
      const isReady = Boolean(
        activeAsset?.referencePath &&
        activeAsset.previewUrl &&
        activeAsset.generationVersion === CURRENT_CLOTHING_ASSET_VERSION
      );
      readiness.textContent = isReady
        ? "AI-READY FOR CURRENT CHARACTER"
        : "NOT AI-READY FOR CURRENT CHARACTER — PREPARE IN PROFILE";

      const selectButton = document.createElement("button");
      selectButton.type = "button";
      selectButton.className = "clothing-item-select";
      const isSelected = selectedItems.some((selected) => selected.id === item.id);
      selectButton.textContent = isSelected ? "REMOVE" : "ADD";
      selectButton.setAttribute("aria-pressed", String(isSelected));
      selectButton.disabled = !isReady;
      selectButton.addEventListener("click", () => {
        if (isSelected) {
          selectedItems = selectedItems.filter((selected) => selected.id !== item.id);
        } else {
          if (selectedItems.length >= 5) {
            outfitMessage.textContent = "CHOOSE UP TO FIVE ITEMS FOR ONE OUTFIT.";
            return;
          }
          addSelectedItem(item);
        }

        outfitMessage.textContent = "";
        renderCurrentOutfit();
        renderClothingItems();
      });

      card.append(category, name, readiness);
      card.appendChild(selectButton);
      clothingGrid.appendChild(card);
    });
  }

  document.querySelector("#save-outfit")?.addEventListener("click", () => {
    void (async () => {
      if (!selectedItems.length) {
        outfitMessage.textContent = "ADD AT LEAST ONE AI-READY ITEM BEFORE SAVING.";
        return;
      }
      const nameInput = document.querySelector<HTMLInputElement>("#outfit-name");
      const name = nameInput?.value.trim() ?? "";
      if (!name || name.length > 80) {
        outfitMessage.textContent = "ENTER AN OUTFIT NAME BETWEEN 1 AND 80 CHARACTERS.";
        return;
      }
      if (!supabase) throw new Error("SUPABASE IS NOT CONFIGURED.");
      const { data: session, error } = await supabase.auth.getSession();
      const accessToken = session.session?.access_token;
      if (error || !accessToken) throw new Error("PLEASE LOG IN AGAIN BEFORE SAVING AN OUTFIT.");
      const outfit = await saveDressedOutfit(
        accessToken,
        name,
        selectedItems.map(({ id }) => id)
      );
      savedDressedOutfits = [
        outfit,
        ...savedDressedOutfits.filter((saved) => saved.id !== outfit.id),
      ];
      renderSavedOutfits();
      outfitMessage.textContent = `${outfit.name.toUpperCase()} SAVED.`;
    })().catch((error) => {
      console.error("Could not save the DRESSED outfit.", error);
      outfitMessage.textContent = error instanceof Error
        ? error.message
        : "COULD NOT SAVE THIS OUTFIT.";
    });
  });

  let savedDressedOutfits: SavedDressedOutfit[] = [];
  let savedOutfitIndex = 0;

  function renderSavedOutfits() {
    savedOutfitsGrid.replaceChildren();
    const relevantOutfits = savedDressedOutfits.filter((outfit) =>
      outfit.characterId === activeCharacterId &&
      outfit.baseType === primaryCharacterBaseType
    );
    if (relevantOutfits.length === 0) {
      const empty = document.createElement("p");
      empty.className = "saved-outfits-empty";
      empty.textContent = "NO SAVED OUTFITS YET.";
      savedOutfitsGrid.appendChild(empty);
      return;
    }
    savedOutfitIndex = Math.min(Math.max(savedOutfitIndex, 0), relevantOutfits.length - 1);
    const outfit = relevantOutfits[savedOutfitIndex];
    {
      const card = document.createElement("article");
      card.className = "saved-outfit-card";
      const name = document.createElement("strong");
      name.textContent = outfit.name;
      const itemNames = outfit.itemIds.map((id) =>
        clothingItems.find((item) => item.id === id)?.name ?? "Unavailable clothing item"
      );
      const summary = document.createElement("small");
      summary.textContent = itemNames.join(" · ");
      const actions = document.createElement("div");
      actions.className = "saved-outfit-actions";
      const loadButton = document.createElement("button");
      loadButton.type = "button";
      loadButton.className = "clothing-item-select";
      loadButton.textContent = "LOAD OUTFIT";
      loadButton.disabled = outfit.itemIds.length > 5 ||
        outfit.itemIds.some((id) => {
          const item = clothingItems.find((candidate) => candidate.id === id);
          const asset = item?.aiReadyAssets?.[outfit.baseType];
          return !item ||
            asset?.generationVersion !== CURRENT_CLOTHING_ASSET_VERSION;
        });
      loadButton.addEventListener("click", () => {
        selectedItems = outfit.itemIds.map((id) =>
          clothingItems.find((item) => item.id === id)!
        );
        renderCurrentOutfit();
        renderClothingItems();
        outfitMessage.textContent = `${outfit.name.toUpperCase()} LOADED.`;
      });
      const deleteButton = document.createElement("button");
      deleteButton.type = "button";
      deleteButton.className = "remove-outfit-item";
      deleteButton.textContent = "DELETE";
      deleteButton.addEventListener("click", () => {
        void (async () => {
          if (!supabase) throw new Error("SUPABASE IS NOT CONFIGURED.");
          const { data: session, error } = await supabase.auth.getSession();
          const accessToken = session.session?.access_token;
          if (error || !accessToken) throw new Error("PLEASE LOG IN AGAIN.");
          if (!await deleteSavedDressedOutfit(accessToken, outfit)) return;
          savedDressedOutfits = savedDressedOutfits.filter(({ id }) => id !== outfit.id);
          renderSavedOutfits();
          outfitMessage.textContent = `${outfit.name.toUpperCase()} DELETED.`;
        })().catch((error) => {
          console.error("Could not delete the saved DRESSED outfit.", error);
          outfitMessage.textContent = error instanceof Error
            ? error.message
            : "COULD NOT DELETE THE SAVED OUTFIT.";
        });
      });
      actions.append(loadButton, deleteButton);
      card.append(name, summary, actions);
      if (relevantOutfits.length > 1) {
        const nav = document.createElement("div");
        nav.className = "saved-outfit-nav";
        const prev = document.createElement("button");
        prev.type = "button";
        prev.textContent = "←";
        prev.setAttribute("aria-label", "Previous saved outfit");
        prev.addEventListener("click", () => {
          savedOutfitIndex = (savedOutfitIndex - 1 + relevantOutfits.length) % relevantOutfits.length;
          renderSavedOutfits();
        });
        const position = document.createElement("small");
        position.textContent = `${savedOutfitIndex + 1} / ${relevantOutfits.length}`;
        const next = document.createElement("button");
        next.type = "button";
        next.textContent = "→";
        next.setAttribute("aria-label", "Next saved outfit");
        next.addEventListener("click", () => {
          savedOutfitIndex = (savedOutfitIndex + 1) % relevantOutfits.length;
          renderSavedOutfits();
        });
        nav.append(prev, position, next);
        savedOutfitsGrid.append(nav);
      }
      savedOutfitsGrid.prepend(card);
    }
  }

  const applyOutfitButton = document.querySelector<HTMLButtonElement>("#apply-outfit");
  const clearOutfitButton = document.querySelector<HTMLButtonElement>("#clear-outfit");

  clearOutfitButton?.addEventListener("click", () => {
    selectedItems = [];
    outfitMessage.textContent = "";
    renderCurrentOutfit();
    renderClothingItems();
  });

  applyOutfitButton?.addEventListener("click", () => {
    renderCharacterLayers();
    outfitMessage.textContent = selectedItems.length
      ? "OUTFIT APPLIED TO YOUR CHARACTER."
      : "ADD AI-READY ITEMS TO BUILD AN OUTFIT.";
  });

  async function initializeWardrobe() {
    renderCategoryFilters();
    renderCurrentOutfit();
    renderClothingItems();
    if (!supabase) return;
    const { data: session, error } = await supabase.auth.getSession();
    const accessToken = session.session?.access_token;
    if (error || !accessToken) return;
    await loadPrimaryCharacter();
    const saved = await loadPersistentWardrobe(accessToken);
    savedDressedOutfits = await loadSavedDressedOutfits(accessToken);
    clothingItems = saved.items.map((stored) => ({
      id: stored.id,
      name: stored.name,
      category: stored.category.toUpperCase(),
      referencePath: stored.referencePath ?? undefined,
      previewUrl: stored.previewUrl ?? undefined,
      cleanPreviewUrl: stored.cleanPreviewUrl ?? undefined,
      generationVersion: stored.generationVersion,
      baseType: stored.baseType ?? undefined,
      aiReadyAssets: stored.aiReadyAssets,
      originalPath: stored.originalPath ?? undefined,
      originalPreviewUrl: stored.originalPreviewUrl ?? undefined,
      placement: stored.placement ?? null,
    }));
    selectedItems = selectedItems.filter((selected) =>
      clothingItems.some((item) => item.id === selected.id)
    );
    renderClothingItems();
    renderCurrentOutfit();
    renderSavedOutfits();
  }
  void initializeWardrobe().catch((error) => {
    console.error("Could not initialize the DRESSED wardrobe.", error);
    outfitMessage.textContent = "COULD NOT LOAD YOUR CLOSET DATA.";
  });
</script>

<script>
  import { supabase } from "../lib/supabase";

  const checkWardrobeSession = async () => {
    if (!supabase) {
      window.location.replace("/login?reason=config");
      return;
    }

    try {
      const { data, error } = await supabase.auth.getSession();

      if (error) {
        console.error("Could not verify the wardrobe session.", error);
        window.location.replace("/login?reason=session");
        return;
      }

      if (!data.session) {
        window.location.replace("/login");
      }
    } catch (error) {
      console.error("Unexpected error while verifying the wardrobe session.", error);
      window.location.replace("/login?reason=session");
    }
  };

  void checkWardrobeSession();

  // Back/forward cache: a bfcache-restored page never re-runs its scripts, so
  // re-invoke the existing guard — a logged-out visitor is redirected and the
  // restored outfit/wardrobe DOM is never left visible.
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) void checkWardrobeSession();
  });
</script>
