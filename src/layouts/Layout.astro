---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/layout.css";
import "../styles/profile-theme.css";
import "../styles/flow-progress.css";

interface Props {
  title: string;
  header?: "public" | "app";
  bodyClass?: string;
}

const { title, header = "public", bodyClass } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="CLOSET — Your digital wardrobe." />
    <title>{title}</title>
  </head>

  <body class={bodyClass}>
    <Header variant={header} />

    <main class="site-main">
      <slot />
    </main>

    <Footer />

    <script>
      import { initGenerationFlow } from "../lib/client/generation-flow";
      initGenerationFlow();
    </script>
  </body>
</html>